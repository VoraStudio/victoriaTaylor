{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Notícia",
    "description": "News articles for Victoria Taylor"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "location": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["exposicion", "entrevista", "colaboracion", "reconocimiento", "feria", "otro"],
      "default": "otro"
    },
    "description": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "cta_label": {
      "type": "string",
      "default": "Leer noticia"
    },
    "cta_url": {
      "type": "string",
      "default": "#"
    }
  }
}
